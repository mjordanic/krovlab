# Copy to .env and fill in. `.env` is gitignored.
# `uv run --extra web python -m web` loads `.env` (does not override
# variables already in the environment). Cloud Run uses Secret Manager, not this file.
# The devcontainer also passes these through from the host (see
# .devcontainer/devcontainer.json containerEnv). Only set what you use.

# Web help agent — paste the Google AI Studio key. Need help? appears when set.
GEMINI_API_KEY=""

# Either an API key...
ANTHROPIC_API_KEY="sk-ant-......"
# ...or a Claude Code OAuth token (claude setup-token). One of the two is enough.
CLAUDE_CODE_OAUTH_TOKEN=""

# Optional — only if your project hits OpenAI.
OPENAI_API_KEY=""
